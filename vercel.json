{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@9.12.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build --filter=@agentglass/dashboard",
  "outputDirectory": "apps/dashboard/.next",
  "env": {
    "NEXT_PUBLIC_SHOWCASE_MODE": "true",
    "ENABLE_EXPERIMENTAL_COREPACK": "1"
  }
}
